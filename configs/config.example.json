{
  "api": {
    "timeout": 60,
    "jwtSecret": "your_jwt_secret_here"
  },
  "app": {
    "url": "http://localhost:9090",
    "port": ":9090",
    "host": "0.0.0.0"
  },
  "db": {
    "host": "localhost",
    "port": 5432,
    "user": "postgres",
    "pass": "your_database_password",
    "name": "erp",
    "crypto_pass": "your_crypto_password"
  },
  "permify": {
    "endpoint": "localhost:3478"
  },
  "nats": {
    "url": "nats://localhost:4222",
    "stream": "erp_events"
  },
  "log": {
    "level": "INFO"
  },
  "otel": {
    "exporter_otlp": "localhost:4317",
    "service_name": "erp"
  },
  "client": {
    "url": "https://your-frontend-domain.com"
  },
  "email": {
    "host": "smtp.gmail.com",
    "port": 465,
    "user": "your-email@example.com",
    "password": "your_app_password"
  },
  "shutdown_timeout": 30
}